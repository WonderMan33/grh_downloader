<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Golden Radio Hour – Show Downloads</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <style>
    :root{
      --red:#b5121b;
      --red-dark:#941018;
      --gold:#d99b20;
      --black:#171717;
      --text:#222;
      --muted:#666;
      --border:#dddddd;
      --white:#ffffff;
      --shadow:0 8px 24px rgba(0,0,0,.08);
    }

    *{
      box-sizing:border-box;
    }

    html,
    body{
      margin:0;
      padding:0;
    }

    body{
      font-family:
        Inter,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;

      background:#fff;
      color:var(--text);
    }

    .app{
      width:100%;
      max-width:1100px;
      margin:0 auto;
      padding:8px 10px 14px;
    }

    header{
      display:flex;
      justify-content:space-between;
      align-items:center;
      gap:16px;
      padding:4px 2px 12px;
      margin-bottom:10px;
      border-bottom:3px solid var(--red);
    }

    .title-wrap{
      min-width:0;
    }

    h1{
      margin:0;
      display:flex;
      align-items:center;
      gap:8px;
      color:var(--black);
      font-size:1.35rem;
      line-height:1.2;
      font-weight:800;
    }

    .logo-dot{
      width:9px;
      height:9px;
      border-radius:50%;
      background:var(--gold);
      flex:0 0 auto;
    }

    header p{
      margin:4px 0 0;
      color:var(--muted);
      font-size:.82rem;
      line-height:1.35;
    }

    .pill{
      flex:0 0 auto;
      padding:5px 10px;
      border:1px solid #e0c487;
      border-radius:4px;
      background:#fffaf0;
      color:#775a18;
      font-size:.72rem;
      font-weight:700;
      white-space:nowrap;
    }

    .panel{
      background:var(--white);
      border:1px solid var(--border);
      border-radius:7px;
      box-shadow:var(--shadow);
      padding:10px;
    }

    .count-label{
      margin-bottom:8px;
      color:var(--muted);
      font-size:.76rem;
      font-weight:700;
      text-align:right;
    }

    .list{
      max-height:640px;
      overflow-y:auto;
      overflow-x:hidden;
      padding-right:3px;
      scrollbar-width:thin;
      scrollbar-color:#bbbbbb transparent;
    }

    .list::-webkit-scrollbar{
      width:7px;
    }

    .list::-webkit-scrollbar-track{
      background:transparent;
    }

    .list::-webkit-scrollbar-thumb{
      background:#c7c7c7;
      border-radius:10px;
    }

    .card{
      display:grid;
      grid-template-columns:minmax(0,1fr) auto;
      align-items:center;
      gap:16px;
      padding:10px 12px;
      margin-bottom:5px;
      border:1px solid #e1e1e1;
      border-left:3px solid var(--gold);
      border-radius:4px;
      background:#fff;
      transition:
        background .12s ease,
        border-color .12s ease;
    }

    .card:hover{
      background:#fafafa;
      border-color:#d3d3d3;
      border-left-color:var(--red);
    }

    .card-header{
      min-width:0;
    }

    .show-name{
      margin:0 0 4px;
      color:var(--black);
      font-size:.93rem;
      line-height:1.25;
      font-weight:750;
    }

    .show-description{
      margin:0;
      color:var(--muted);
      font-size:.74rem;
      line-height:1.4;
    }

    .btn-row{
      display:flex;
      justify-content:flex-end;
      align-items:center;
    }

    .btn{
      min-height:32px;
      padding:0 11px;
      border:1px solid var(--red);
      border-radius:4px;
      background:var(--red);
      color:#fff;
      font-size:.72rem;
      font-weight:800;
      text-decoration:none;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      white-space:nowrap;
      transition:
        background .15s ease,
        border-color .15s ease;
    }

    .btn:hover{
      background:var(--red-dark);
      border-color:var(--red-dark);
    }

    .hint{
      margin-top:9px;
      padding-top:8px;
      border-top:1px solid #eeeeee;
      color:var(--muted);
      font-size:.70rem;
      line-height:1.4;
    }

    .hint strong{
      color:#444;
    }

    .empty{
      padding:28px 10px;
      text-align:center;
      color:var(--muted);
      font-size:.85rem;
    }

    @media(max-width:600px){

      .app{
        padding:5px 6px 10px;
      }

      header{
        align-items:flex-start;
        flex-direction:column;
      }

      h1{
        font-size:1.15rem;
      }

      .pill{
        display:none;
      }

      .panel{
        padding:8px;
      }

      .list{
        max-height:620px;
      }

      .card{
        grid-template-columns:1fr;
        gap:8px;
        padding:10px;
      }

      .btn-row{
        justify-content:flex-start;
      }

      .btn{
        width:100%;
      }
    }
  </style>
</head>

<body>

  <div class="app">

    <header>

      <div class="title-wrap">

        <h1>
          <span class="logo-dot"></span>
          Golden Radio Hour – Show Downloads
        </h1>

        <p>
          Download complete old time radio show archives for your personal collection.
        </p>

      </div>

      <div class="pill">
        Full-show ZIP archives
      </div>

    </header>

    <section class="panel">

      <div
        class="count-label"
        id="countLabel"
      >
        Loading…
      </div>

      <div
        class="list"
        id="showList"
      ></div>

      <div class="hint">
        Tip: If your browser opens the ZIP instead of downloading it,
        right-click the download button and choose
        <strong>“Save link as…”</strong>.
      </div>

    </section>

  </div>

  <script>

    const JSON_URL =
      "https://wonderman33.github.io/grh_downloader/zipped_shows.json";

    const showListEl =
      document.getElementById("showList");

    const countLabelEl =
      document.getElementById("countLabel");


    function safeName(show){

      if(
        show.name &&
        show.name.trim()
      ){
        return show.name;
      }

      return show.id || "Untitled Show";
    }


    function renderList(shows){

      showListEl.innerHTML = "";

      if(!shows.length){

        showListEl.innerHTML = `
          <div class="empty">
            No show downloads are currently available.
          </div>
        `;

        countLabelEl.textContent =
          "0 shows";

        return;
      }


      shows.forEach(show => {

        const card =
          document.createElement("div");

        card.className =
          "card";


        const header =
          document.createElement("div");

        header.className =
          "card-header";


        const title =
          document.createElement("h2");

        title.className =
          "show-name";

        title.textContent =
          safeName(show);


        const description =
          document.createElement("p");

        description.className =
          "show-description";

        description.textContent =
          show.description ||
          "Classic old time radio show archive.";


        header.appendChild(title);
        header.appendChild(description);


        const btnRow =
          document.createElement("div");

        btnRow.className =
          "btn-row";


        if(show.zipUrl){

          const link =
            document.createElement("a");

          link.className =
            "btn";

          link.href =
            show.zipUrl;

          link.textContent =
            "Download ZIP";

          link.setAttribute(
            "download",
            ""
          );

          btnRow.appendChild(link);

        }


        card.appendChild(header);
        card.appendChild(btnRow);

        showListEl.appendChild(card);

      });


      countLabelEl.textContent =
        shows.length +
        (
          shows.length === 1
            ? " show"
            : " shows"
        );

    }


    async function loadShows(){

      try{

        const response =
          await fetch(
            JSON_URL,
            {
              cache:"no-cache"
            }
          );

        if(!response.ok){
          throw new Error(
            "HTTP " + response.status
          );
        }

        const data =
          await response.json();

        const shows =
          Array.isArray(data)
            ? data
            : [];

        renderList(shows);

      }

      catch(error){

        console.error(
          "Could not load show JSON:",
          error
        );

        showListEl.innerHTML = `
          <div class="empty">
            Show downloads could not be loaded.
          </div>
        `;

        countLabelEl.textContent =
          "Unable to load shows";

      }

    }


    loadShows();

  </script>

</body>
</html>
